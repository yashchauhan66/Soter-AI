{
  "manifest_version": 3,
  "name": "Soter Enterprise AI Control Plane",
  "short_name": "Soter",
  "description": "Prevent company secrets, PII, source code, and sensitive business data from leaking into public LLM tools like ChatGPT, Claude, and Gemini.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "sidePanel",
    "storage",
    "scripting",
    "alarms",
    "identity",
    "identity.email"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Soter Enterprise AI Control Plane",
    "default_popup": "popup/index.html",
    "default_icon": { "16": "assets/icon-192.png", "32": "assets/icon-192.png", "128": "assets/icon-192.png" }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": { "16": "assets/icon-192.png", "48": "assets/icon-192.png", "128": "assets/icon-192.png" },
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "key": "soter_enterprise_ai_control_plane"
}
