{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@soterai/guard-core": [
        "./packages/guard-core/src/index.ts"
      ],
      "@soterai/guard-core/*": [
        "./packages/guard-core/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-e2e/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "credentials",
    "packages",
    "apps/extension",
    "apps/extension/**",
    "apps/local-ai-broker",
    "apps/local-ai-broker/**",
    "examples",
    "examples/**",
    "scripts",
    "tests",
    "extensions",
    "extensions/**"
  ]
}
