      "parameters": {
        "content": "## Ultra-Pro SaaS Helpdesk (SoterAI + Groq)\nChat -> Input Guard (BLOCK, session-aware) -> PII Redactor -> Intent Router (bug/human/general) -> Groq LLM -> Output Guard (REDACT) -> Chat.",
        "height": 140,
        "width": 900,
        "color": 5
      }
    }
