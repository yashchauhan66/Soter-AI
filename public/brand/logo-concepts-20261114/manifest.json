  "concepts": [
    {
      "id": "01",
      "slug": "boundary-s",
      "name": "Boundary S",
      "meaning": "A custom S built from opposing enclosure bands. A memorable signature for controlled AI access.",
      "recommended": true
    },
    {
      "id": "02",
      "slug": "keystone-crest",
      "name": "Keystone Crest",
      "meaning": "An S-shaped negative passage cut into a compact shield. The clearest immediate security signal.",
      "recommended": true
    },
    {
      "id": "03",
      "slug": "guarded-core",
      "name": "Guarded Core",
      "meaning": "A protected diamond core with a controlled entrance. A direct link to securing agents and their tools.",
      "recommended": true
    },
    {
      "id": "04",
      "slug": "sentry-gate",
      "name": "Sentry Gate",
      "meaning": "Architectural boundaries protect an upright core. Access control expressed in a developer-friendly mark."
    },
    {
      "id": "05",
      "slug": "trust-link",
      "name": "Trust Link",
      "meaning": "Two substantial links form a trusted connection. Designed for secure integrations, permissions and collaboration."
    },
    {
      "id": "06",
      "slug": "sentinel-fold",
      "name": "Sentinel Fold",
      "meaning": "Three bold folds form an upright guardian. An abstract, confident identity built around protection."
    },
    {
      "id": "07",
      "slug": "policy-seal",
      "name": "Policy Seal",
      "meaning": "A strong octagonal boundary with verification built into its negative space. Assurance without visual clutter."
    },
    {
      "id": "08",
      "slug": "agent-orbit",
      "name": "Agent Orbit",
      "meaning": "Opposing protective bands surround a square agent core. A softer expression of secure, controlled autonomy."
    },
    {
      "id": "09",
      "slug": "vault-cut",
      "name": "Vault Cut",
      "meaning": "A clipped enclosure with an angular key aperture. A restrained identity for secrets, credentials and privacy."
    },
    {
      "id": "10",
      "slug": "guard-rail",
      "name": "Guard Rail",
      "meaning": "Execution lanes stop at a decisive policy boundary. A minimal direction for enforcement and safe automation."
    }
  ],
