<idea-plugin>
    <id>ai.soterai.jetbrains.guard</id>
    <name>SoterAI IDE Guard</name>
    <vendor url="https://soterai.in">SoterAI</vendor>
    <description><![CDATA[
      <p>Local-first AI security controls for content explicitly scanned or routed through SoterAI.</p>
      <p>The plugin connects to an authenticated loopback Local AI Broker. Raw source, secrets, prompts,
      and terminal output are not sent to SoterAI Cloud by default. It does not transparently intercept
      every third-party AI assistant or terminal command.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="ai.soterai.guard.settings.BrokerSettings"/>
        <applicationConfigurable
                id="ai.soterai.guard.settings"
                displayName="SoterAI IDE Guard"
                instance="ai.soterai.guard.settings.SoterAIConfigurable"/>
        <toolWindow id="SoterAI Guard"
                anchor="right"
                factoryClass="ai.soterai.guard.ui.SoterAIToolWindowFactory"/>
        <statusBarWidgetFactory id="SoterAIStatus"
                implementation="ai.soterai.guard.ui.SoterAIStatusWidgetFactory"/>
        <notificationGroup id="SoterAI Guard" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="SoterAI.ScanSelection"
                class="ai.soterai.guard.actions.ScanSelectionAction"
                text="Scan Selection with SoterAI"
                description="Scan selected text through the authenticated local broker">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="SoterAI.ScanCurrentFile"
                class="ai.soterai.guard.actions.ScanCurrentFileAction"
                text="Scan Current File with SoterAI"
                description="Scan the current editor document through the authenticated local broker">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="SoterAI.RedactSelection"
                class="ai.soterai.guard.actions.RedactSelectionAction"
                text="Redact Selection for AI with SoterAI"
                description="Replace selected text with a locally redacted version">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="SoterAI.ToggleSafeMode"
                class="ai.soterai.guard.actions.ToggleSafeModeAction"
                text="Toggle SoterAI Safe Mode"
                description="Enable or disable Local AI Broker Safe Mode">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

