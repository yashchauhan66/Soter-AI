Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: SoterAI IDE Guard
Bundle-SymbolicName: ai.soterai.guard;singleton:=true
Bundle-Version: 0.1.0.qualifier
Bundle-Vendor: SoterAI
Bundle-Activator: ai.soterai.guard.Activator
Automatic-Module-Name: ai.soterai.guard
Bundle-RequiredExecutionEnvironment: JavaSE-17
