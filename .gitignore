/Microsoft/
/UsersUSERAppDataLocalTempsoter-pip-test/

# scratch/audit/test-run leftovers (regenerable; never commit)
.tmp-*
test-output.txt
test_soter.txt
tsc-report.txt
test-screenshot.png

# curl/debug artifacts that can leak live session tokens & headers
cookies.txt
headers.txt
*.cookies
cookies-*.txt

# ML training artifacts (not needed at runtime; regenerable via Colab notebook)
/datasets/
/colab-train-bundle/*
!/colab-train-bundle/README.md
!/colab-train-bundle/package-manifest.json
soterai-train-bundle.zip
# Keep runtime ONNX model under models/ tracked, but never the training-only weights
models/**/pytorch_model.bin

# scratch/runtime test dirs
/tmp/

# Model-signing PRIVATE keys (scripts/ml/sign-model-artifact.ts). The trust store
# under artifacts/security/ holds public keys and IS committed on purpose — it is
# the operator's declaration of which signers may ship models. The private half
# must never be.
/.soterai/model-signing/
*.signing-key.pem
operator-signing-key.pem*

# Host-test scaffolding: dist-test is a build output, .vscode-test is a ~350MB
# downloaded VS Code the host suite launches. Both are regenerable.
packages/vscode-extension/dist-test/
packages/vscode-extension/.vscode-test/

# Compiled output of the n8n node's in-package test suite. `node --test` only
# discovers tests when cwd is inside the directory, so the suite is compiled
# here first; the TypeScript sources under test/ are what get reviewed.
packages/integrations/n8n/test-build/

SOTERAI-TEST-SECRETS.env
.env
.env.backup-*
*.backup-pre-*
.env.backup-pre-margin-deploy
# The rules above only match backups named .env.backup-*, but a rotated env gets
# whatever name the person rotating it typed -- .env.pre-v14.bak and
# .env.production.pre-v14.bak both slipped through as untracked-but-addable while
# holding the same live secrets as .env itself. Match the shapes, not one spelling.
.env*.bak
.env*.backup*
.env.production.*
# ...but .env.example and .env.production.example are deliberately tracked
# templates carrying no real values, and the broad rule above swallows the second
# one. Re-admit them explicitly so a delete-and-re-add cannot lose them.
!.env.example
!.env.production.example
