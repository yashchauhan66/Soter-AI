# ML training artifacts (not needed at runtime; regenerable via Colab notebook)
/datasets/
/colab-train-bundle/*
!/colab-train-bundle/README.md
!/colab-train-bundle/package-manifest.json
soterai-train-bundle.zip
# Keep runtime ONNX model under models/ tracked, but never the training-only weights
models/**/pytorch_model.bin

# scratch/runtime test dirs
/tmp/

# Model-signing PRIVATE keys (scripts/ml/sign-model-artifact.ts). The trust store
# under artifacts/security/ holds public keys and IS committed on purpose — it is
# the operator's declaration of which signers may ship models. The private half
# must never be.
/.soterai/model-signing/
*.signing-key.pem
operator-signing-key.pem*

# Host-test scaffolding: dist-test is a build output, .vscode-test is a ~350MB
# downloaded VS Code the host suite launches. Both are regenerable.
packages/vscode-extension/dist-test/
packages/vscode-extension/.vscode-test/

SOTERAI-TEST-SECRETS.env
.env
.env.backup-*
*.backup-pre-*
.env.backup-pre-margin-deploy
