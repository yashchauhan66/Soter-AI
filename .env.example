SOTER_API_KEY="your-api-key-here"
SOTER_BASE_URL="https://api.soterai.in"
DATABASE_URL="postgresql://user:password@localhost:5432/soter"
# Playwright may migrate and seed this database. Always use an isolated test DB.
E2E_DATABASE_URL="postgresql://user:password@localhost:5432/soter_e2e"
REDIS_URL="redis://localhost:6379"
SIEM_WORKER_HEALTH_PORT="3097"
NEXTAUTH_SECRET="replace-with-a-long-random-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Email verification (mock prints email metadata locally; use a live provider in production).
EMAIL_PROVIDER="mock"
EMAIL_FROM="SoterAI <no-reply@example.com>"
# Optional dedicated OTP HMAC key; otherwise AUTH_SECRET/NEXTAUTH_SECRET is used.
EMAIL_OTP_SECRET="replace-with-a-long-random-secret"
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_TLS="true"

# DynamoDB heavy event store. Prefer an EC2 IAM role in production.
AWS_REGION="ap-south-1"
# Leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_PROFILE unset when using an EC2 IAM role.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_PROFILE=""
DYNAMODB_ENDPOINT=""
DYNAMODB_EVENTS_ENABLED="false"
DYNAMODB_EVENTS_TABLE="soterai_events"
DYNAMODB_EVENTS_DUAL_WRITE="false"
DYNAMODB_EVENTS_READ_FALLBACK_POSTGRES="true"
DYNAMODB_EVENTS_TTL_GUARD_DAYS="7"
DYNAMODB_EVENTS_TTL_AUDIT_DAYS="90"
DYNAMODB_EVENTS_TTL_WEBHOOK_DAYS="14"
DYNAMODB_EVENTS_TTL_INCIDENT_DAYS="180"
DYNAMODB_EVENTS_TTL_PAYLOAD_DAYS="7"
DYNAMODB_EVENTS_TTL_REPORT_DAYS="30"
DYNAMODB_EVENTS_TTL_WORKER_DAYS="14"
DYNAMODB_EVENTS_TTL_REDACTION_DAYS="7"
DYNAMODB_EVENTS_TTL_RAG_DAYS="30"
DYNAMODB_EVENTS_TTL_RETEAM_DAYS="30"
DYNAMODB_EVENTS_MAX_INPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_OUTPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_METADATA_BYTES="12000"

# ── ML detection tier (recall booster for novel/unseen attacks) ──────────────
# The fine-tuned ONNX classifier augments the deterministic rules with semantic
# recall. It is ADDITIVE and OFF by default. Rollout is staged and reversible.
#
#   off     (default) — ML never runs; guard behaves exactly as rules-only.
#   shadow            — ML runs and records what it WOULD do in metadata.ml,
#                       but does NOT change any decision. Use this to gather
#                       production evidence with zero user-facing risk.
#   enforce           — an ML hit escalates to at most HUMAN_REVIEW (never a
#                       hard BLOCK on its own). A stricter rules action is kept.
# Enable shadow first, review metadata.ml over real traffic, then enforce.
SOTERAI_ML_AUGMENT="off"
# Path to the ONNX model + labels. v4 is the current model (temperature-calibrated
# MLP head; ships calibration.json for per-label thresholds + OOD abstention).
# ML_ONNX_MODEL_PATH="models/ml-classifier-v4/model.onnx"
# ML_ONNX_LABELS_PATH="models/ml-classifier-v4/labels.json"
# ML_ONNX_CALIBRATION_PATH="models/ml-classifier-v4/calibration.json"
# ML_ONNX_MAX_LENGTH="256"
#
# ── REQUIRED before the model can load at all ──────────────────────────────
# The loader is fail-closed: it will not deserialize a model until a signed
# manifest and an operator trust store admit it. Setting SOTERAI_ML_AUGMENT
# WITHOUT these means the model never loads and the guard silently runs
# rules-only. Generate both in one step:
#
#   npm run ml:sign -- --model models/ml-classifier-v4/model.onnx --source local-training
#
# then uncomment:
# SOTERAI_MODEL_TRUST_STORE="artifacts/security/model-trust-store.json"
# SOTERAI_MODEL_APPROVED_SOURCES="local-training"
#
# Score long inputs as overlapping windows instead of truncating at the model
# window, so an injection buried deep in a pasted document is still seen.
#
# OFF by default on purpose. The sweep works (tests/ml/sliding-window.test.ts
# proves coverage and localization), but on the v4 decision layer it does not yet
# pay for itself. Measured with `npm run ml:evidence:window`:
#   INPUT  — 0/4 buried payloads recovered, 0/4 new false positives
#            (every window label is filtered by INPUT_RELIABLE_LABELS)
#   OUTPUT — 1/4 recovered, 1/4 NEW false positive (a benign contract escalates)
#   latency — 0.5-1.0s truncated becomes 1.7-2.3s swept
# Two v4 defects block it: the abstention gate scores 9-class entropy, so an
# attack whose mass splits across attack labels is demoted to SAFE; and long
# prose draws arbitrary attack labels. Re-run the evidence script before turning
# this on.
ML_ONNX_SLIDING_WINDOW="off"
# Turn "the ML tier is configured but never loaded" into a hard failure instead of
# a silent downgrade to rules-only. Recommended in production.
#
# With this ON and the tier degraded (see lib/guard/guardHealth.ts):
#   `npm run ml:health` exits 1, so a release step can refuse to promote the build
#   GET /api/health answers 503, so an orchestrator pulls the instance
# It does NOT abort the process at boot: a running instance keeps serving with
# rules only — that is still the fail-open contract — but it stops advertising
# itself as healthy while it does.
#
# With this OFF, a degraded tier is reported as a warning and nothing fails.
SOTERAI_ML_REQUIRE_HEALTHY="off"
# Minimum confidence for an ML prediction to count. Tune from the floor sweep;
# higher = fewer false positives. Default is deliberately conservative.
ML_ONNX_CONFIDENCE_FLOOR="0.5"
