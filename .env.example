SOTER_API_KEY="your-api-key-here"
SOTER_BASE_URL="https://api.soterai.in"
DATABASE_URL="postgresql://user:password@localhost:5432/soter"
# Playwright may migrate and seed this database. Always use an isolated test DB.
E2E_DATABASE_URL="postgresql://user:password@localhost:5432/soter_e2e"
REDIS_URL="redis://localhost:6379"
SIEM_WORKER_HEALTH_PORT="3097"
NEXTAUTH_SECRET="replace-with-a-long-random-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Email verification (mock prints email metadata locally; use a live provider in production).
EMAIL_PROVIDER="mock"
EMAIL_FROM="SoterAI <no-reply@example.com>"
# Optional dedicated OTP HMAC key; otherwise AUTH_SECRET/NEXTAUTH_SECRET is used.
EMAIL_OTP_SECRET="replace-with-a-long-random-secret"
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_TLS="true"

# DynamoDB heavy event store. Prefer an EC2 IAM role in production.
AWS_REGION="ap-south-1"
# Leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_PROFILE unset when using an EC2 IAM role.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_PROFILE=""
DYNAMODB_ENDPOINT=""
DYNAMODB_EVENTS_ENABLED="false"
DYNAMODB_EVENTS_TABLE="soterai_events"
DYNAMODB_EVENTS_DUAL_WRITE="false"
DYNAMODB_EVENTS_READ_FALLBACK_POSTGRES="true"
DYNAMODB_EVENTS_TTL_GUARD_DAYS="7"
DYNAMODB_EVENTS_TTL_AUDIT_DAYS="90"
DYNAMODB_EVENTS_TTL_WEBHOOK_DAYS="14"
DYNAMODB_EVENTS_TTL_INCIDENT_DAYS="180"
DYNAMODB_EVENTS_TTL_PAYLOAD_DAYS="7"
DYNAMODB_EVENTS_TTL_REPORT_DAYS="30"
DYNAMODB_EVENTS_TTL_WORKER_DAYS="14"
DYNAMODB_EVENTS_TTL_REDACTION_DAYS="7"
DYNAMODB_EVENTS_TTL_RAG_DAYS="30"
DYNAMODB_EVENTS_TTL_RETEAM_DAYS="30"
DYNAMODB_EVENTS_MAX_INPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_OUTPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_METADATA_BYTES="12000"

# ── ML detection tier (recall booster for novel/unseen attacks) ──────────────
# The fine-tuned ONNX classifier augments the deterministic rules with semantic
# recall. It is ADDITIVE and OFF by default. Rollout is staged and reversible.
#
#   off     (default) — ML never runs; guard behaves exactly as rules-only.
#   shadow            — ML runs and records what it WOULD do in metadata.ml,
#                       but does NOT change any decision. Use this to gather
#                       production evidence with zero user-facing risk.
#   enforce           — an ML hit escalates to at most HUMAN_REVIEW (never a
#                       hard BLOCK on its own). A stricter rules action is kept.
# Enable shadow first, review metadata.ml over real traffic, then enforce.
SOTERAI_ML_AUGMENT="off"
# Path to the ONNX model + labels. v3 is the hard-negative-hardened model; v2 is
# the fallback. Only set these once the model has been verified on the held-out
# set (scripts/guard-benchmark/ml-v3-verify.ts) with FPR under ~1%.
# ML_ONNX_MODEL_PATH="models/ml-classifier-v3/model.onnx"
# ML_ONNX_LABELS_PATH="models/ml-classifier-v3/labels.json"
# Minimum confidence for an ML prediction to count. Tune from the floor sweep;
# higher = fewer false positives. Default is deliberately conservative.
ML_ONNX_CONFIDENCE_FLOOR="0.9"
