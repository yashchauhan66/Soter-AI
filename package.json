{
  "name": "soterai",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "clean": "node scripts/cleanNextBuild.mjs",
    "build": "next build",
