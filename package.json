s/project-flow.test.ts tests/auth-signup.test.ts tests/logs-filters.test.ts tests/ai-data-security.test.ts tests/ai-data-security-fingerprint-e2e.test.ts tests/ai-data-security-privacy.test.ts tests/benchmarks/honest-benchmark.test.ts tests/benchmarks/external-benchmark.test.ts tests/gateway.test.ts tests/mcp-gateway.test.ts tests/model-scan.test.ts tests/mcp-gateway.test.ts tests/mcp-runtime-smoke.test.ts tests/mcp-http.test.ts",
    "test:market": "tsx --test tests/trust-events.test.ts tests/causal-siem.test.ts tests/compliance-assurance.test.ts tests/rag-authorization-continuity.test.ts tests/agent-passport-delegation.test.ts tests/agent-behavior-baseline.test.ts tests/ai-bom-cyclonedx.test.ts tests/a2a-security.test.ts tests/agent-market-gap-features.test.ts",
