    "bench:vscode": "tsx packages/vscode-extension/benchmarks/bench.ts",
    "bench:all": "npm run bench:guard-core && npm run bench:broker && npm run bench:vscode",
    "verify:dashboard-metrics": "tsx scripts/verifyDashboardMetrics.ts",
