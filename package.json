    "audit:ui": "node scripts/audit-undefined-utilities.mjs && node scripts/audit-card-affordance.mjs && node scripts/audit-table-drift.mjs && node scripts/audit-hardcoded-colors.mjs && node scripts/verify-palette-contrast.mjs",
