    "ml:train:v4": "python scripts/ml/train-soterllm-v4.py --train-datasets datasets/ml-augmented-v6.jsonl --epochs 4 --batch-size 12 --max-length 256 --output-dir models/ml-classifier-v4 --no-cuda",
    "ml:train:v4:gpu": "python scripts/ml/train-soterllm-v4.py --train-datasets datasets/ml-augmented-v6.jsonl --epochs 5 --batch-size 64 --max-length 256 --output-dir models/ml-classifier-v4",
