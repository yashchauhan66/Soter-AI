{
  "name": "soterai",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "clean": "node scripts/cleanNextBuild.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:otp": "tsx --test tests/email-otp.test.ts tests/auth-signup.test.ts tests/api-route-audit.test.ts",
    "test:readiness": "tsx --test tests/readiness-deliverables.test.ts",
    "test:phase3": "tsx --test tests/guard/jailbreak-expanded.test.ts tests/guard/system-prompt-leak-expanded.test.ts tests/guard/data-exfiltration-expanded.test.ts tests/guard/tool-abuse-expanded.test.ts tests/guard/rag-poisoning-expanded.test.ts tests/guard/multilingual-hinglish-expanded.test.ts tests/guard/benign-false-positive-expanded.test.ts",
    "test": "tsx --test tests/dynamodb-events.test.ts tests/guard/governance-enforcement.test.ts tests/docs-service-catalog.test.ts tests/auth.test.ts tests/guard.test.ts tests/guard/invisible-unicode-smuggling.test.ts tests/guard/output-exfiltration.test.ts tests/guard/mcp-poisoning-obfuscation.test.ts tests/guard-redteam-benchmark.test.ts tests/guard/safety-regression.test.ts tests/guard/safety-round2-regression.test.ts tests/guard/multi-turn-safety.test.ts tests/guard/heldout-generalization.test.ts tests/integrations/integration-kit.test.ts tests/integrations/agent-firewall-integration.test.ts tests/security.test.ts tests/credential-vault-security.test.ts tests/webhooks.test.ts tests/agent-firewall.test.ts tests/agent-firewall-mvp3.test.ts tests/agent-passport.test.ts tests/agent-intent.test.ts tests/tool-chain.test.ts tests/escrow.test.ts tests/dry-run.test.ts tests/semantic-egress.test.ts tests/evidence-vault.test.ts tests/canary-network-feature7.test.ts tests/rag-rescan.test.ts tests/advanced-security-mvp1.test.ts tests/advanced-security-mvp2.test.ts tests/advanced-security-mvp3.test.ts tests/phase2.test.ts tests/phase3.test.ts tests/phase4.test.ts tests/phase5.test.ts tests/phase6.test.ts tests/phase9.test.ts tests/phase10.test.ts tests/phase11.test.ts tests/phase12.test.ts tests/slm-evaluation.test.ts tests/performance.test.ts tests/api-route-audit.test.ts tests/integrations.test.ts tests/retention.test.ts tests/billing.test.ts tests/project-flow.test.ts tests/auth-signup.test.ts tests/logs-filters.test.ts tests/ai-data-security.test.ts tests/ai-data-security-fingerprint-e2e.test.ts tests/ai-data-security-privacy.test.ts tests/benchmarks/honest-benchmark.test.ts",
    "test:market": "tsx --test tests/trust-events.test.ts tests/causal-siem.test.ts tests/compliance-assurance.test.ts tests/rag-authorization-continuity.test.ts tests/agent-passport-delegation.test.ts tests/agent-behavior-baseline.test.ts tests/ai-bom-cyclonedx.test.ts tests/a2a-security.test.ts tests/agent-market-gap-features.test.ts",
    "test:load": "tsx scripts/loadTest.ts",
    "test:load:http": "tsx scripts/httpLoadTest.ts",
    "perf:guard": "node scripts/perf/guard-api-load-test.js",
    "perf:pages": "node scripts/perf/public-pages-load-test.js",
    "perf:dashboard": "node scripts/perf/dashboard-load-test.js",
    "perf:logs": "node scripts/perf/logs-scale-test.js",
    "perf:reports": "node scripts/perf/report-generation-test.js",
    "perf:monitor": "node scripts/perf/server-resource-monitor.js",
    "build:sdk:js": "npm --prefix packages/sdk run build",
    "test:sdk:js": "npm --prefix packages/sdk run test",
    "build:extension": "npm --prefix apps/extension run build",
    "typecheck:extension": "npm --prefix apps/extension run typecheck",
    "test:extension": "tsx --test tests/extension/*.test.ts",
    "vscode:package": "npm --prefix packages/vscode-extension run vscode:package",
    "vscode:publish": "npm --prefix packages/vscode-extension run vscode:publish",
    "openvsx:package": "npm --prefix packages/vscode-extension run openvsx:package",
    "openvsx:publish": "npm --prefix packages/vscode-extension run openvsx:publish",
    "test:vscode-family": "node scripts/test-vscode-family.mjs all",
    "test:cursor": "node scripts/test-vscode-family.mjs cursor",
    "test:vscodium": "node scripts/test-vscode-family.mjs codium",
    "validate:extension-permissions": "node scripts/validate-manifest-permissions.js",
    "validate:api-contract": "node scripts/validate-api-contract.mjs",
    "package": "npm --prefix apps/extension run package",
    "test:admin-ai-policies": "tsx --test tests/admin-ai-policies/*.test.ts",
    "test:sdk:python": "cd packages/python-sdk && python -m pytest tests/",
    "package:wordpress": "node scripts/packageWordpressPlugin.mjs",
    "validate:marketplaces": "node scripts/export-marketplace-icons.mjs && node scripts/validate-marketplace-packages.mjs",
    "test:integrations": "npm run test:sdk:js && tsx --test tests/integrations.test.ts",
    "verify:integrations": "npm --prefix packages/sdk run typecheck && npm run test:sdk:js && npm run build:sdk:js",
    "verify": "npm run typecheck && npm --prefix packages/sdk run typecheck && npm test && npx prisma validate && npm run build",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:seed": "tsx scripts/seedDemo.ts",
    "worker:webhooks": "tsx workers/webhookWorker.ts",
    "worker:siem": "tsx workers/siemWorker.ts",
    "worker:background": "tsx workers/backgroundWorker.ts",
    "worker:threat-intel": "tsx workers/threatIntelWorker.ts",
    "dynamodb:events:create": "tsx scripts/aws/create-dynamodb-events-table.ts",
    "dynamodb:events:ttl": "tsx scripts/aws/enable-dynamodb-events-ttl.ts",
    "dynamodb:events:verify": "tsx scripts/aws/verify-dynamodb-events-table.ts",
    "dynamodb:events:iam-policy": "tsx scripts/aws/print-dynamodb-events-iam-policy.ts",
    "logs:backfill:dynamodb": "tsx scripts/migration/backfill-postgres-heavy-logs-to-dynamodb.ts",
    "logs:cleanup:postgres": "tsx scripts/migration/cleanup-old-postgres-heavy-logs.ts",
    "eval:classifiers": "tsx scripts/evalClassifiers.ts",
    "benchmark:honest": "tsx scripts/guard-benchmark/run-honest-benchmark.ts",
    "bench:guard-core": "tsx packages/guard-core/benchmarks/bench.ts",
    "bench:broker": "tsx apps/local-ai-broker/benchmarks/bench.ts",
    "bench:vscode": "tsx packages/vscode-extension/benchmarks/bench.ts",
    "bench:all": "npm run bench:guard-core && npm run bench:broker && npm run bench:vscode",
    "smoke:broker": "tsx scripts/runtime-smoke-local-ai-broker.ts",
    "smoke:agent-mcp": "tsx scripts/runtime-smoke-agent-mcp-governance.ts",
    "smoke:rag-rescan": "tsx scripts/runtime-smoke-rag-rescan.ts",
    "smoke:enterprise-sso-scim": "tsx scripts/runtime-smoke-enterprise-sso-scim.ts",
    "smoke:extension-runtime": "npm run build:extension && tsx scripts/runtime-smoke-extension-browser-flow.ts",
    "smoke:guard-market": "tsx scripts/runtime-smoke-guard-market-benchmark.ts",
    "verify:dashboard-metrics": "tsx scripts/verifyDashboardMetrics.ts",
    "demo:reset": "tsx scripts/resetDemoWorkspace.ts",
    "validate-env": "tsx scripts/validate-env.ts",
    "test:e2e": "node scripts/runPlaywright.mjs",
    "test:e2e:ui": "node scripts/runPlaywright.mjs --ui",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-dynamodb": "^3.1079.0",
    "@aws-sdk/lib-dynamodb": "^3.1079.0",
    "@next/third-parties": "^16.2.9",
    "@prisma/client": "5.22.0",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "clsx": "2.1.1",
    "iconv-lite": "^0.6.3",
    "lucide-react": "0.468.0",
    "next": "15.5.19",
    "next-auth": "^5.0.0-beta.25",
    "pdfkit": "^0.15.1",
    "razorpay": "^2.9.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "redis": "^4.7.0",
    "tailwind-merge": "2.6.0",
    "tesseract.js": "^6.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.10.2",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "postcss": "8.5.10",
    "prettier": "^3.3.0",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.22.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "^9.0.1"
  }
}
