{
  "name": "SoterAI Agent Passport Lifecycle",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "action": "enrollIdentity",
        "detectionEngine": "CLOUD",
        "agentName": "n8n Support Agent Demo",
        "agentType": "CHATBOT",
        "agentDescription": "Example least-privilege support agent",
        "passportPolicyPreset": "SUPPORT",
        "advancedOptions": { "includeRawResponse": false }
      },
      "id": "enroll-identity",
      "name": "Enroll Agent Identity",
      "type": "n8n-nodes-soterai.soterGuard",
      "typeVersion": 2,
      "position": [420, 300],
      "credentials": { "soterApi": { "id": "SOTERAI_API_PLACEHOLDER", "name": "SoterAI API" } }
    },
    {
      "parameters": {
        "action": "issuePassport",
        "detectionEngine": "CLOUD",
        "agentIdentityId": "={{ $json.agentIdentityId }}",
        "passportTtlSeconds": 900,
        "passportPolicyPreset": "SUPPORT",
        "sessionId": "={{ 'n8n-demo-' + $execution.id }}",
        "advancedOptions": { "includeRawResponse": false }
      },
      "id": "issue-passport",
      "name": "Issue Agent Passport",
      "type": "n8n-nodes-soterai.soterGuard",
      "typeVersion": 2,
      "position": [680, 300],
      "credentials": { "soterApi": { "id": "SOTERAI_API_PLACEHOLDER", "name": "SoterAI API" } }
    },
    {
      "parameters": {
        "action": "validatePassport",
        "detectionEngine": "CLOUD",
        "sessionId": "={{ $json.sessionId }}",
        "passportToken": "={{ $json.passportToken }}",
        "toolName": "rag.search",
        "toolAction": "query",
        "advancedOptions": { "includeRawResponse": false }
      },
      "id": "validate-passport",
      "name": "Validate Agent Passport",
      "type": "n8n-nodes-soterai.soterGuard",
      "typeVersion": 2,
      "position": [940, 300],
      "credentials": { "soterApi": { "id": "SOTERAI_API_PLACEHOLDER", "name": "SoterAI API" } }
    },
    {
      "parameters": {
        "action": "toolCall",
        "detectionEngine": "CLOUD",
        "sessionId": "={{ $('Issue Agent Passport').item.json.sessionId }}",
        "passportToken": "={{ $('Issue Agent Passport').item.json.passportToken }}",
        "toolName": "rag.search",
        "toolAction": "query",
        "toolContent": "Find the public refund policy",
        "toolDestination": "internal",
        "advancedOptions": { "includeRawResponse": false }
      },
      "id": "check-tool-call",
      "name": "Check Agent Tool Call",
      "type": "n8n-nodes-soterai.soterGuard",
      "typeVersion": 2,
      "position": [1200, 260],
      "credentials": { "soterApi": { "id": "SOTERAI_API_PLACEHOLDER", "name": "SoterAI API" } }
    },
    {
      "parameters": {
        "action": "revokePassport",
        "detectionEngine": "CLOUD",
        "passportId": "={{ $('Issue Agent Passport').item.json.passportId }}",
        "revokeReason": "Example workflow completed",
        "advancedOptions": { "includeRawResponse": false }
      },
      "id": "revoke-passport",
      "name": "Revoke Agent Passport",
      "type": "n8n-nodes-soterai.soterGuard",
      "typeVersion": 2,
      "position": [1460, 260],
      "credentials": { "soterApi": { "id": "SOTERAI_API_PLACEHOLDER", "name": "SoterAI API" } }
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Enroll Agent Identity", "type": "main", "index": 0 }]] },
    "Enroll Agent Identity": { "main": [[{ "node": "Issue Agent Passport", "type": "main", "index": 0 }], []] },
    "Issue Agent Passport": { "main": [[{ "node": "Validate Agent Passport", "type": "main", "index": 0 }], []] },
    "Validate Agent Passport": { "main": [[{ "node": "Check Agent Tool Call", "type": "main", "index": 0 }], []] },
    "Check Agent Tool Call": { "main": [[{ "node": "Revoke Agent Passport", "type": "main", "index": 0 }], []] }
  }
}