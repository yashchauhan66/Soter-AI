{
  "name": "n8n-nodes-soterai",
  "version": "0.6.0",
  "description": "SoterAI helps protect n8n AI workflows by detecting prompt injection, jailbreaks, secrets, PII, and unsafe AI instructions.",
  "license": "MIT",
  "author": {
    "name": "SoterAI",
    "email": "support@soterai.in",
    "url": "https://soterai.in"
  },
  "homepage": "https://github.com/yashchauhan66/Soter-AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashchauhan66/Soter-AI.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ai-security",
    "prompt-injection",
    "ai-guardrails",
    "jailbreak",
    "pii",
    "secrets",
    "security",
    "soterai",
    "guardrails"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SoterApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SoterGuard/SoterGuard.node.js"
    ]
  },
  "main": "dist/nodes/SoterGuard/SoterGuard.node.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && copyfiles \"nodes/**/*.svg\" \"credentials/**/*.svg\" dist",
    "dev": "tsc --watch",
    "lint": "n8n-node lint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-package.cjs",
    "test:unit": "tsc -p tsconfig.test.json && cd test-build && node --test",
    "test:redos": "node scripts/redos-sweep.cjs",
    "test:stress": "node scripts/stress-local-engine.cjs",
    "measure": "node scripts/measure-local-engine.cjs",
    "test": "npm run validate && npm run typecheck && npm run test:unit && npm run test:redos && npm run test:stress",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.42.2",
    "copyfiles": "^2.4.1",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
