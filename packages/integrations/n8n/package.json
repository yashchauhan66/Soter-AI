{
  "name": "n8n-nodes-soterai",
  "version": "0.8.8",
  "description": "SoterAI helps protect n8n AI workflows by detecting prompt injection, jailbreaks, secrets, PII, and unsafe AI instructions.",
  "license": "MIT",
  "author": {
    "name": "SoterAI",
    "email": "support@soterai.in",
    "url": "https://soterai.in"
  },
  "homepage": "https://soterai.in/docs",
  "bugs": {
    "url": "https://soterai.in/support"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yashchauhan66/Soter-AI",
    "directory": "packages/integrations/n8n"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ai-security",
    "prompt-injection",
    "ai-guardrails",
    "jailbreak",
    "pii",
    "secrets",
    "security",
    "soterai",
    "guardrails"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SoterApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SoterGuard/SoterGuard.node.js"
    ]
  },
  "main": "dist/nodes/SoterGuard/SoterGuard.node.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.cjs",
    "build": "npm run clean && tsc && node scripts/copy-icons.cjs",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials shared package.json --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-package.cjs",
    "test:unit": "tsc -p tsconfig.test.json && cd test-build && node --test",
    "test:redos": "node scripts/redos-sweep.cjs",
    "test:stress": "node scripts/stress-local-engine.cjs",
    "measure": "node scripts/measure-local-engine.cjs",
    "test": "npm run validate && npm run typecheck && npm run test:unit && npm run test:redos && npm run test:stress",
    "prepublishOnly": "npm test && npm run build && node ../../../scripts/minify-published-dist.mjs ."
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@eslint/js": "^9.29.0",
    "@n8n/eslint-plugin-community-nodes": "0.35.0",
    "esbuild": "0.28.1",
    "eslint": "9.29.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import-x": "^4.15.2",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "n8n-workflow": "2.42.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.70.0"
  }
}
