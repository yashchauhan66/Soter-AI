# Package only the bundled output + manifest + docs + icon.
# Everything else (source, tests, symlinked monorepo, caches) is excluded so
# vsce never walks the 60k-file symlinked node_modules tree.

# Source & build config
src/**
benchmarks/**
esbuild.js
esbuild.host-tests.js
tsconfig.json
tsconfig.*.json
.eslintrc*
eslint.config.*
**/*.map

# Dependencies — guard-core is bundled into dist/extension.js, so none are needed
node_modules/**

# Tests, coverage, fixtures
**/__tests__/**
**/*.test.*
coverage/**
.nyc_output/**
out/**
# Host-test bundle and the downloaded VS Code it runs against — test-only,
# and .vscode-test is a ~350MB unpacked editor. Neither belongs in a VSIX.
dist-test/**
.vscode-test/**

# Repo / tooling noise
.vscode/**
.git/**
.gitignore
.vscodeignore
**/.DS_Store
canaryVerify.ts
test_output*.txt

# Ad-hoc / large assets
*.vsix

# Marketplace screenshots are intentionally not bundled or shown in the README.
media/screenshots/**

# Helper scripts (not needed by users)
scripts/**
