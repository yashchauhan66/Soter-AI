{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "outDir": "dist",
        "lib": [
            "es2022"
        ],
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rootDir": "src"
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}