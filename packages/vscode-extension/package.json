                {
                    "id": "soterai-policy-status",
                    "name": "Policy & Cloud Sync Status"
                }
            ]
        },
        "configuration": {
            "title": "SoterAI IDE Guard Settings",
            "properties": {
                "soterai.cloud.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable cloud features like policy sync and high-risk cloud scan escalation."
                },
                "soterai.cloud.baseUrl": {
                    "type": "string",
                    "default": "https://api.soterai.in",
                    "description": "SoterAI cloud environment base URL."
                },
                "soterai.policy.mode": {
                    "type": "string",
                    "enum": [
                        "local",
                        "team",
                        "enterprise"
                    ],
                    "default": "local",
                    "description": "Security policy mode."
                },
                "soterai.scan.remoteEscalation": {
                    "type": "string",
                    "enum": [
                        "never",
                        "high-risk-only",
                        "enterprise-required"
                    ],
                    "default": "never",
                    "description": "Escalate high-risk scanning to cloud (redacted/minimized payload only)."
                },
                "soterai.telemetry.redactedEvents": {
                    "type": "string",
                    "enum": [
                        "off",
                        "high-risk-only",
                        "batched"
                    ],
                    "default": "off",
                    "description": "Redacted telemetry event collection level."
                },
                "soterai.scan.maxFileSizeKb": {
                    "type": "number",
                    "default": 256,
                    "description": "Maximum file size to scan locally in KB."
                },
                "soterai.scan.maxWorkspaceFiles": {
                    "type": "number",
                    "default": 1000,
                    "description": "Maximum files to check during workspace security scans."
                },
                "soterai.scan.excludeGlobs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/dist/**",
                        "**/build/**",
                        "**/*.bin",
                        "**/*.exe",
                        "**/*.zip",
                        "**/*.png",
                        "**/*.jpg"
                    ],
                    "description": "Exclude glob patterns from file scans."
                },
                "soterai.broker.port": {
                    "type": "number",
                    "default": 47321,
                    "minimum": 1024,
                    "maximum": 65535,
                    "description": "Loopback-only Local AI Broker port."
                },
                "soterai.broker.openAIProviderUrl": {
                    "type": "string",
                    "default": "",
                    "description": "OpenAI-compatible upstream chat completions endpoint. Stored locally."
                },
                "soterai.broker.anthropicProviderUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Anthropic-compatible upstream messages endpoint. Stored locally."
                },
                "soterai.terminal.protectionMode": {
                    "type": "string",
                    "enum": [
                        "manual",
                        "warn",
                        "approval"
                    ],
                    "default": "warn",
                    "description": "Action on detecting dangerous terminal commands."
                }
            }
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --import tsx --test src/__tests__/**/*.test.ts",
        "bundle": "node esbuild.js --production",
        "vscode:prepublish": "npm run bundle",
        "package": "vsce package --allow-missing-repository --skip-license --no-dependencies",
        "vscode:package": "vsce package --allow-missing-repository --skip-license --no-dependencies",
        "vscode:publish": "vsce publish --no-dependencies",
        "openvsx:package": "npm run vscode:package",
    "openvsx:publish": "node ../../scripts/publish-openvsx.mjs"
    },
    "devDependencies": {
        "@soterai/guard-core": "file:../guard-core",
        "@types/node": "22.10.2",
        "@types/vscode": "^1.85.0",
        "@vscode/vsce": "^2.32.0",
        "esbuild": "^0.24.0",
        "ovsx": "^0.10.12",
        "tsx": "^4.19.0",
        "typescript": "^5.9.3"
    }
}
