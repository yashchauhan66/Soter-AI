    "repository": {
        "type": "git",
        "url": "https://github.com/yashchauhan66/Ai-Security-Guard.git",
        "directory": "packages/vscode-extension"
    },
    "bugs": {
        "url": "https://github.com/yashchauhan66/Ai-Security-Guard/issues"
    },
    "homepage": "https://soterai.in/vscode-ai-security",
    "qna": "https://soterai.in/support",
    "activationEvents": [
        "workspaceContains:.soterai-policy.json"
    ],
    "main": "./dist/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "SoterAI IDE Guard runs all secret/PII/prompt-injection scanning fully locally, so scanning works in restricted mode. Cloud connection, token storage, and remote scan escalation are disabled in untrusted workspaces until you trust the workspace."
        }
    },
