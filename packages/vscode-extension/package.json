    "publisher": "soterai",
    "preview": true,
    "pricing": "Free",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#0B1020",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "AI",
        "Linters",
        "Other"
    ],
    "keywords": [
        "ai-security",
        "ai-coding",
        "prompt-injection",
        "secret-scanning",
        "mcp-security",
        "cursor",
        "copilot",
        "claude",
        "local-ai",
        "data-leakage",
        "vscode-security",
        "developer-security",
        "ai-agent-security",
        "ai-safe-mode",
        "ai-memory-inspector"
