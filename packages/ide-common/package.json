{
    "name": "@soterai/ide-common",
    "version": "0.1.0",
    "description": "Shared TypeScript client and helpers for SoterAI IDE adapters: authenticated Local AI Broker client, token loading, feature flags, and test fixtures. No detector logic.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "tsx --test src/__tests__/**/*.test.ts",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist",
        "prepublishOnly": "npm run build"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "soterai",
        "ide-guard",
        "broker-client",
        "local-first"
    ],
    "author": "SoterAI",
    "license": "BSL-1.1",
    "homepage": "https://github.com/yashchauhan66/Soter-AI",
    "repository": {
        "type": "git",
        "url": "https://github.com/yashchauhan66/Soter-AI.git",
        "directory": "packages/ide-common"
    },
    "bugs": {
        "url": "https://github.com/yashchauhan66/Soter-AI/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@soterai/ide-protocol": "^0.1.0"
    },
    "devDependencies": {
        "@types/node": "22.10.2",
        "typescript": "^5.9.3",
        "tsx": "4.22.4",
        "rimraf": "^6.0.0"
    }
}
