{
  "name": "@soterai/mcp-gateway",
  "version": "0.2.0",
  "description": "SoterAI MCP Gateway — inline MCP enforcement proxy with policy-based tool-call interception, approval workflow, and result secret-scanning. Zero-dependency, works with any MCP-aware AI stack.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "soterai-mcp-gateway": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "npm run build && node --test dist/__tests__/mcp-gateway.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "soterai",
    "mcp",
    "ai-security",
    "gateway",
    "policy",
    "proxy",
    "llm",
    "agent",
    "tool-safety"
  ],
  "author": "SoterAI",
  "license": "MIT",
  "homepage": "https://github.com/yashchauhan66/Soter-AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashchauhan66/Soter-AI.git",
    "directory": "packages/mcp-gateway"
  },
  "bugs": {
    "url": "https://github.com/yashchauhan66/Soter-AI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0"
  }
}
