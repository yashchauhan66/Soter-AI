NODE_ENV="production"
AUTH_REQUIRE_EMAIL_VERIFICATION="true"

# Public URLs
NEXT_PUBLIC_APP_URL="https://soterai.in"
NEXTAUTH_URL="https://soterai.in"
AUTH_TRUST_HOST="true"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
POSTGRES_PASSWORD="replace-with-strong-postgres-password"

# Auth and signing secrets
# Generate random values with: openssl rand -base64 32
AUTH_SECRET="replace-with-strong-auth-secret"
NEXTAUTH_SECRET="replace-with-same-value-as-auth-secret"
API_KEY_PEPPER="replace-with-strong-api-key-pepper"
SCIM_TOKEN_PEPPER="replace-with-strong-scim-token-pepper"
WEBHOOK_SECRET_PEPPER="replace-with-strong-webhook-secret-pepper"
AUDIT_EXPORT_SECRET="replace-with-strong-audit-export-secret"
REPORT_SIGNING_SECRET="replace-with-strong-report-signing-secret"

# Demo account. Leave blank or remove in real production if not needed.
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""

# Rate limits and plan limits
MAX_GUARD_TEXT_LENGTH="8000"
DEFAULT_RPM="60"
PUBLIC_ANALYZE_RPM="20"
FREE_PLAN_LIMIT_PER_MONTH="1000"
STARTER_LIMIT_PER_MONTH="10000"
PRO_LIMIT_PER_MONTH="50000"
AGENCY_LIMIT_PER_MONTH="250000"
ENTERPRISE_LIMIT_PER_MONTH="5000000"

# Vector store
VECTOR_PROVIDER="qdrant"
QDRANT_URL="https://your-cluster.region.cloud.qdrant.io"
QDRANT_API_KEY="replace-with-qdrant-api-key"
# Required for production RAG indexing unless VECTOR_ALLOW_LOCAL_EMBEDDINGS=true is intentionally used.
EMBEDDING_API_URL=""
EMBEDDING_API_KEY=""
VECTOR_DIMENSIONS="64"

# Email
EMAIL_PROVIDER="resend"
EMAIL_FROM="SoterAI Support <support@soterai.in>"
RESEND_API_KEY="replace-with-resend-api-key"
AUTH_EXPOSE_DEVELOPMENT_OTP="false"
AWS_REGION="ap-south-1"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_TLS="false"
SMTP_HELO="soterai.in"

# Billing
RAZORPAY_KEY_ID="rzp_live_replace_with_live_key_id"
RAZORPAY_KEY_SECRET="replace-with-live-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-live-razorpay-webhook-secret"
RAZORPAY_PLAN_STARTER="replace-with-live-starter-plan-id"
RAZORPAY_PLAN_PRO="replace-with-live-pro-plan-id"
RAZORPAY_PLAN_AGENCY="replace-with-live-agency-plan-id"
ENTERPRISE_CONTACT_EMAIL="support@soterai.in"

# Workers
WEBHOOK_WORKER_TOKEN="generate-long-random-webhook-worker-token"
WEBHOOK_WORKER_INTERVAL_MS="5000"
WEBHOOK_WORKER_HEALTH_PORT="3099"
REPORT_WORKER_TOKEN="generate-long-random-report-worker-token"
BACKGROUND_WORKER_INTERVAL_MS="5000"
BACKGROUND_WORKER_HEALTH_PORT="3098"
THREAT_INTEL_WORKER_INTERVAL_MS="300000"
THREAT_INTEL_WORKER_HEALTH_PORT="3097"
SIEM_WORKER_INTERVAL_MS="5000"
SIEM_WORKER_HEALTH_PORT="3096"

# Redis / Upstash
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"
REDIS_URL=""

# DynamoDB heavy event store
DYNAMODB_EVENTS_ENABLED="true"
DYNAMODB_EVENTS_TABLE="soterai_events"
DYNAMODB_EVENTS_DUAL_WRITE="true"
DYNAMODB_EVENTS_READ_FALLBACK_POSTGRES="true"
DYNAMODB_ENDPOINT=""
DYNAMODB_EVENTS_TTL_GUARD_DAYS="7"
DYNAMODB_EVENTS_TTL_AUDIT_DAYS="90"
DYNAMODB_EVENTS_TTL_WEBHOOK_DAYS="14"
DYNAMODB_EVENTS_TTL_INCIDENT_DAYS="180"
DYNAMODB_EVENTS_TTL_PAYLOAD_DAYS="7"
DYNAMODB_EVENTS_TTL_REPORT_DAYS="30"
DYNAMODB_EVENTS_TTL_WORKER_DAYS="14"
DYNAMODB_EVENTS_TTL_REDACTION_DAYS="7"
DYNAMODB_EVENTS_TTL_RAG_DAYS="30"
DYNAMODB_EVENTS_TTL_RETEAM_DAYS="30"
DYNAMODB_EVENTS_MAX_INPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_OUTPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_METADATA_BYTES="12000"

# Secret store. Do not use local in production.
SECRET_STORE_PROVIDER="aws-kms"
AWS_KMS_KEY_ID="replace-with-aws-kms-key-id"
# If the EC2 instance has a proper IAM role, leave AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY unset in the real production secret.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_EC2_METADATA_DISABLED="false"
GCP_PROJECT_ID=""
GCP_LOCATION=""
GCP_KEY_RING=""
GCP_CRYPTO_KEY=""
GCP_KMS_KEY_ID=""
VAULT_ADDR=""
VAULT_TOKEN=""
VAULT_TRANSIT_KEY=""

# Classifiers
ENABLE_SEMANTIC_DETECTORS="false"
ENABLE_MULTILINGUAL_DETECTORS="false"
ENABLE_HINDI_HINGLISH_DETECTION="false"
SOTERAI_ML_AUGMENT="enforce"
ML_ONNX_MODEL_PATH="models/ml-classifier-v3/model.onnx"
ML_ONNX_LABELS_PATH="models/ml-classifier-v3/labels.json"
ML_ONNX_CONFIDENCE_FLOOR="0.5"

# Optional SLM-as-judge / AI assistant
SLM_API_KEY=""
SLM_API_URL="https://api.groq.com/openai/v1"
SLM_MODEL="llama-3.1-8b-instant"

# Optional internal API demo keys used by some dashboard examples
SOTER_API_KEY=""
SOTERAI_API_KEY=""
SOTERAI_ADMIN_KEY=""
CYBERSECURITYGUARD_API_KEY=""
CYBERSECURITYGUARD_BASE_URL="https://soterai.in"

# Optional enterprise integrations
SAML_SP_ENTITY_ID=""
SAML_SP_ACS_URL=""
IDENTITY_FABRIC_SECRET=""
PARENT_PASSPORT_TOKEN=""
SOTER_EXTENSION_TOKEN=""
SOTER_EXTENSION_DEVICE_TOKEN=""
SOTER_EXTENSION_TOKEN_ORG_ID=""
SOTER_AGENT_DEVICE_TOKEN=""
GITHUB_MCP_TOKEN=""

# Analytics / verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
