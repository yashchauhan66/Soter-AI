# Database
DATABASE_URL="postgresql://user:password@host:5432/soter?schema=public"
REDIS_URL="redis://:password@host:6379/0"

# Auth
NEXTAUTH_URL="https://soterai.in"
NEXTAUTH_SECRET="generate-a-strong-secret-key-here"

# Core Configuration
NEXT_PUBLIC_APP_URL="https://soterai.in"
ENROLLMENT_SECRET_KEY="generate-enrollment-secret-here"
ADMIN_EMAIL="admin@your-company.com"

# Logging / SIEM
# SIEM_WEBHOOK_URL="https://your-siem-provider.com/api/webhook"
# LOG_LEVEL="info"

# DynamoDB heavy event store. Leave access keys blank when using an EC2 IAM role.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
DYNAMODB_EVENTS_ENABLED="false"
DYNAMODB_EVENTS_TABLE="soterai_events"
DYNAMODB_EVENTS_DUAL_WRITE="false"
DYNAMODB_EVENTS_READ_FALLBACK_POSTGRES="true"
DYNAMODB_EVENTS_TTL_GUARD_DAYS="7"
DYNAMODB_EVENTS_TTL_AUDIT_DAYS="90"
DYNAMODB_EVENTS_TTL_WEBHOOK_DAYS="14"
DYNAMODB_EVENTS_TTL_INCIDENT_DAYS="180"
DYNAMODB_EVENTS_TTL_PAYLOAD_DAYS="7"
DYNAMODB_EVENTS_TTL_REPORT_DAYS="30"
DYNAMODB_EVENTS_TTL_WORKER_DAYS="14"
DYNAMODB_EVENTS_TTL_REDACTION_DAYS="7"
DYNAMODB_EVENTS_TTL_RAG_DAYS="30"
DYNAMODB_EVENTS_TTL_RETEAM_DAYS="30"
DYNAMODB_EVENTS_MAX_INPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_OUTPUT_PREVIEW_CHARS="2000"
DYNAMODB_EVENTS_MAX_METADATA_BYTES="12000"

# Optional for local DynamoDB or named local AWS profiles:
AWS_PROFILE=""
DYNAMODB_ENDPOINT=""
