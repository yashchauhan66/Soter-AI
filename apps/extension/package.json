{
  "name": "@soterai/extension",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build && vite build --config vite.content.config.ts && vite build --config vite.lineage.config.ts && vite build --config vite.wshook.config.ts",
    "validate:store": "node scripts/validate-store-manifest.mjs",
    "validate:permissions": "node ../../scripts/validate-manifest-permissions.js",
    "package": "npm run build && npm run validate:store && npm run validate:permissions && node scripts/package.js && node scripts/verify-store-zip.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@soterai/detectors": "file:../../packages/detectors",
    "@soterai/policy-engine": "file:../../packages/policy-engine",
    "@soterai/shared": "file:../../packages/shared"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "typescript": "^5.5.4",
    "vite": "^8.1.3",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
